{
  "id": "/app/",
  "name": "JCondo - App do Morador",
  "short_name": "JCondo",
  "description": "Avisos do condomínio, reserva de áreas comuns e registro de ocorrências.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/app/?origem=pwa",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f3f5f9",
  "theme_color": "#1e3a5f",
  "categories": ["lifestyle", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Reservar área comum",
      "short_name": "Reservar",
      "url": "/app/#/reservas/nova",
      "icons": [{ "src": "icons/atalho-reserva.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Abrir ocorrência",
      "short_name": "Ocorrência",
      "url": "/app/#/ocorrencias/nova",
      "icons": [{ "src": "icons/atalho-ocorrencia.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "icons/tela-inicio.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "Tela inicial do morador" },
    { "src": "icons/tela-reserva.png", "sizes": "540x1170", "type": "image/png", "form_factor": "narrow", "label": "Reserva de área comum" },
    { "src": "icons/tela-desktop.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "App no computador" }
  ]
